{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=urlshortener;Username=devuser;Password=devpass"
  },
  "Features": {
    "Tracking": {
      "Enabled": true
    }
  },
  "UrlShortener": {
    "BaseUrl": "http://localhost:5030"
  },
  "Auth": {
    "Authority": "https://auth.exeal.com",
    "Audience": "401187844204397315"
  },
  "AllowedHosts": "*",
  "RateLimiter": {
    "ResolveLimiter": {
      "PermitLimit": 20
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Exeal.UrlShortener.Api"
    }
  }
}
